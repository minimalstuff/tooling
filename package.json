{
	"name": "@minimalstuff/tooling",
	"version": "0.9.0",
	"description": "Shared tooling configs: EditorConfig, OXC (oxlint + oxfmt), Knip",
	"keywords": [
		"editorconfig",
		"knip",
		"oxc",
		"oxfmt",
		"oxlint",
		"react"
	],
	"homepage": "https://github.com/minimalstuff/tooling#readme",
	"bugs": {
		"url": "https://github.com/minimalstuff/tooling/issues"
	},
	"license": "MIT",
	"author": "Sonny93 <sonnyasdev@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/minimalstuff/tooling"
	},
	"bin": "./dist/cli/index.mjs",
	"files": [
		"dist",
		"preset"
	],
	"type": "module",
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		"./editorconfig": "./preset/.editorconfig",
		"./oxc/lint": "./dist/oxc/lint.mjs",
		"./oxc/fmt": "./dist/oxc/fmt.mjs",
		"./knip": "./dist/knip/knip.mjs"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"knip": "knip",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt && oxlint --fix",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:package": "vitest run --config vitest.package.config.ts",
		"build": "tsdown",
		"checks": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test && pnpm build",
		"release": "release-it",
		"release:next": "release-it --preRelease=next --plugins.@release-it/keep-a-changelog.keepUnreleased"
	},
	"dependencies": {
		"@antfu/install-pkg": "^2.1.0",
		"@clack/prompts": "^1.8.1",
		"jsonc-parser": "^3.3.1",
		"picocolors": "^1.1.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@adonisjs/eslint-plugin": "^2.2.2",
		"@release-it/keep-a-changelog": "^8.0.1",
		"@types/node": "^26.6.6",
		"knip": "6.44.1",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"release-it": "^21.1.2",
		"tsdown": "^0.23.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"@adonisjs/eslint-plugin": "^2.2.2",
		"knip": ">=6.42.1",
		"oxfmt": ">=0.74.0",
		"oxlint": ">=1.89.0",
		"oxlint-tsgolint": ">=7.0.2004"
	},
	"peerDependenciesMeta": {
		"@adonisjs/eslint-plugin": {
			"optional": true
		},
		"knip": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.16.1",
	"release-it": {
		"git": {
			"requireCleanWorkingDir": true,
			"requireUpstream": true,
			"commitMessage": "chore(release): ${version}",
			"tagAnnotation": "v${version}",
			"push": true,
			"tagName": "v${version}",
			"tagExclude": "*.*.*-*"
		},
		"github": {
			"release": true
		},
		"npm": {
			"publish": false
		},
		"plugins": {
			"@release-it/keep-a-changelog": {
				"filename": "CHANGELOG.md",
				"addUnreleased": true,
				"addVersionUrl": true
			}
		}
	}
}
