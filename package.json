{
	"name": "@minimalstuff/tooling",
	"version": "0.6.0",
	"description": "Shared tooling configs: EditorConfig, OXC (oxlint + oxfmt)",
	"keywords": [
		"editorconfig",
		"oxc",
		"oxfmt",
		"oxlint",
		"react"
	],
	"license": "MIT",
	"author": "Sonny93 <sonnyasdev@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/minimalstuff/tooling"
	},
	"bin": "./dist/cli/index.mjs",
	"files": [
		"dist",
		"preset"
	],
	"type": "module",
	"exports": {
		"./editorconfig": "./preset/.editorconfig",
		"./oxc/lint": "./dist/oxc/lint.mjs",
		"./oxc/fmt": "./dist/oxc/fmt.mjs"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt && oxlint --fix",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsdown",
		"checks": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
		"release": "release-it"
	},
	"dependencies": {
		"@adonisjs/eslint-plugin": "^2.2.2",
		"@antfu/install-pkg": "^2.1.0",
		"@clack/prompts": "^1.8.1",
		"jsonc-parser": "^3.3.1",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@release-it/conventional-changelog": "^12.0.2",
		"@types/node": "^26.6.5",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2004",
		"release-it": "^21.1.1",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"oxfmt": ">=0.74.0",
		"oxlint": ">=1.89.0",
		"oxlint-tsgolint": ">=7.0.2004"
	},
	"peerDependenciesMeta": {
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.15.0",
	"release-it": {
		"git": {
			"requireCleanWorkingDir": true,
			"requireUpstream": true,
			"commitMessage": "chore(release): ${version}",
			"tagAnnotation": "v${version}",
			"push": true,
			"tagName": "v${version}"
		},
		"github": {
			"release": true
		},
		"npm": {
			"publish": false
		},
		"plugins": {
			"@release-it/conventional-changelog": {
				"infile": "CHANGELOG.md",
				"preset": {
					"name": "conventionalcommits"
				}
			}
		}
	}
}
